---
import BaseLayout from "./BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.vue";
import CookieConsent from "../components/CookieConsent.vue";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <!-- Navbar slot -->
  <Navbar 
    client:load 
    user={Astro.locals.user} 
    slot="navbar" 
  />
  
  <!-- Main content -->
  <slot />
  
  <!-- Footer slot -->
  <Footer slot="footer" />
  
  <!-- Scripts slot -->
  <Fragment slot="scripts">
    <!-- Cookie Consent Component -->
    <CookieConsent client:load />
    
    <!-- Global handlers for cookie consent events -->
    <script is:inline>
      // Cookie consent handlers
      window.handleConsentChange = function(preferences) {
        console.log('Consent changed:', preferences);
      };

      window.handleAnalyticsChange = function(enabled) {
        console.log('Analytics:', enabled ? 'enabled' : 'disabled');
      };

      window.handleMarketingChange = function(enabled) {
        console.log('Marketing:', enabled ? 'enabled' : 'disabled');
      };
    </script>
  </Fragment>
</BaseLayout>
