---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import compendiumStructure from "../data/compendium-structure.json";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/login");
}

// Get blog posts for left sidebar with proper error handling
const posts = await getCollection("posts");
const recentPosts = posts
  .filter(post => post.data.pubDate) // Filter out posts without pubDate
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 6);

// Get compendium data for right side
const systems = Object.entries(compendiumStructure.systems);

// Mock data for favorites and recent updates (replace with real data from your database)
const favoriteCompendiums = systems.slice(0, 3).map(([key, system]) => ({
  key,
  name: system.name,
  description: system.description,
  collectionsCount: Object.keys(system.collections || {}).length,
  lastViewed: new Date(Date.now() - Math.random() * 7 * 24 * 60 * 60 * 1000).toLocaleDateString()
}));

const recentlyUpdated = systems.slice(2, 5).map(([key, system]) => ({
  key,
  name: system.name,
  description: system.description,
  collectionsCount: Object.keys(system.collections || {}).length,
  lastUpdated: new Date(Date.now() - Math.random() * 3 * 24 * 60 * 60 * 1000).toLocaleDateString(),
  isNew: Math.random() > 0.5
}));
---

<Layout title="Dashboard" description="Your TTRPG.fyi Dashboard">
  <div class="container mx-auto p-4 max-w-7xl">
    <!-- Welcome Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-2">Welcome back, {user.name}! 🎲</h1>
      <p class="text-lg opacity-70">Here's what's happening in your TTRPG world</p>
    </div>

    <!-- Dashboard Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column - Articles (2/3 width on large screens) -->
      <div class="lg:col-span-2">
        <div class="card bg-base-200 shadow-lg">
          <div class="card-body">
            <h2 class="card-title text-2xl mb-6 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              Latest Articles
            </h2>
            
            <div class="space-y-4">
              {recentPosts.length > 0 ? (
                recentPosts.map((post) => (
                  <article class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
                    <div class="card-body p-4">
                      <div class="flex items-start gap-4">
                        {post.data.image && (
                          <div class="avatar">
                            <div class="w-16 h-16 rounded-lg">
                              <img src={post.data.image} alt={post.data.title} class="object-cover" />
                            </div>
                          </div>
                        )}
                        
                        <div class="flex-1">
                          <h3 class="font-bold text-lg mb-2 line-clamp-2">
                            <a href={`/posts/${post.slug}`} class="link link-hover">
                              {post.data.title}
                            </a>
                          </h3>
                          
                          <p class="text-sm opacity-70 line-clamp-2 mb-3">
                            {post.data.description || "No description available"}
                          </p>
                          
                          <div class="flex items-center gap-4 text-xs opacity-60">
                            {post.data.pubDate && (
                              <time datetime={new Date(post.data.pubDate).toISOString()}>
                                {new Date(post.data.pubDate).toLocaleDateString()}
                              </time>
                            )}
                            
                            {post.data.tags && post.data.tags.length > 0 && (
                              <div class="flex gap-1">
                                {post.data.tags.slice(0, 2).map((tag) => (
                                  <span class="badge badge-xs badge-outline" key={tag}>{tag}</span>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                    </div>
                  </article>
                ))
              ) : (
                <div class="text-center py-8">
                  <div class="text-6xl mb-4">📚</div>
                  <h3 class="text-xl font-semibold mb-2">No articles yet</h3>
                  <p class="text-base-content/70">Check back later for the latest TTRPG content!</p>
                </div>
              )}
            </div>
            
            <div class="card-actions justify-center mt-6">
              <a href="/posts" class="btn btn-outline">View All Articles</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Compendium Info (1/3 width on large screens) -->
      <div class="space-y-6">
        
        <!-- Favorite Compendiums -->
        <div class="card bg-base-200 shadow-lg">
          <div class="card-body">
            <h3 class="card-title flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
              Favorite Compendiums
            </h3>
            
            <div class="space-y-3">
              {favoriteCompendiums.map((comp) => (
                <div class="card bg-base-100 shadow-sm" key={comp.key}>
                  <div class="card-body p-3">
                    <h4 class="font-semibold text-sm mb-1">
                      <a href={`/compendium/${comp.key}`} class="link link-hover">
                        {comp.name}
                      </a>
                    </h4>
                    <p class="text-xs opacity-70 line-clamp-2 mb-2">
                      {comp.description}
                    </p>
                    <div class="flex justify-between items-center text-xs opacity-60">
                      <span>{comp.collectionsCount} collections</span>
                      <span>Viewed {comp.lastViewed}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            
            <div class="card-actions justify-center mt-4">
              <a href="/compendium" class="btn btn-sm btn-outline">Browse All</a>
            </div>
          </div>
        </div>

        <!-- Recently Updated Compendiums -->
        <div class="card bg-base-200 shadow-lg">
          <div class="card-body">
            <h3 class="card-title flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              Recently Updated
            </h3>
            
            <div class="space-y-3">
              {recentlyUpdated.map((comp) => (
                <div class="card bg-base-100 shadow-sm" key={comp.key}>
                  <div class="card-body p-3">
                    <div class="flex items-start justify-between mb-1">
                      <h4 class="font-semibold text-sm">
                        <a href={`/compendium/${comp.key}`} class="link link-hover">
                          {comp.name}
                        </a>
                      </h4>
                      {comp.isNew && (
                        <span class="badge badge-success badge-xs">NEW</span>
                      )}
                    </div>
                    <p class="text-xs opacity-70 line-clamp-2 mb-2">
                      {comp.description}
                    </p>
                    <div class="flex justify-between items-center text-xs opacity-60">
                      <span>{comp.collectionsCount} collections</span>
                      <span>Updated {comp.lastUpdated}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            
            <div class="card-actions justify-center mt-4">
              <a href="/compendium" class="btn btn-sm btn-outline">View Updates</a>
            </div>
          </div>
        </div>

        <!-- Quick Stats -->
        <div class="card bg-base-200 shadow-lg">
          <div class="card-body">
            <h3 class="card-title flex items-center gap-2 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              Your Activity
            </h3>
            
            <div class="stats stats-vertical shadow">
              <div class="stat p-3">
                <div class="stat-title text-xs">Collections Viewed</div>
                <div class="stat-value text-lg text-primary">12</div>
                <div class="stat-desc text-xs">This week</div>
              </div>
              
              <div class="stat p-3">
                <div class="stat-title text-xs">Articles Read</div>
                <div class="stat-value text-lg text-secondary">8</div>
                <div class="stat-desc text-xs">This month</div>
              </div>
              
              <div class="stat p-3">
                <div class="stat-title text-xs">Bookmarks</div>
                <div class="stat-value text-lg text-accent">5</div>
                <div class="stat-desc text-xs">Saved items</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="card bg-base-200 shadow-lg">
          <div class="card-body">
            <h3 class="card-title text-sm mb-3">Quick Actions</h3>
            <div class="space-y-2">
              <a href="/compendium" class="btn btn-sm btn-outline w-full justify-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                Browse Compendium
              </a>
              <a href="/posts" class="btn btn-sm btn-outline w-full justify-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                Read Articles
              </a>
              <a href="/profile" class="btn btn-sm btn-outline w-full justify-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                Edit Profile
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
/* Custom line clamp utility */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Card hover effects */
.card {
  transition: all 0.2s ease;
}

.card:hover {
  transform: translateY(-1px);
}

/* Responsive adjustments */
@media (max-width: 1024px) {
  .container {
    padding: 1rem;
  }
}
</style>