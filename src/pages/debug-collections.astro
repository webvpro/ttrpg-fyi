---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';
import { execSync } from 'child_process';

export const prerender = true;

let collectionsStatus: Record<string, string> = {};
let folderStatus: Record<string, any> = {};

// Check what Git thinks the structure is
try {
  const gitFiles = execSync('git ls-tree -r --name-only HEAD', { encoding: 'utf8' });
  const compendiumFiles = gitFiles.split('\n').filter(f => f.includes('compendiums'));
  folderStatus.gitStructure = compendiumFiles.slice(0, 10); // First 10 files
} catch (error) {
  folderStatus.gitError = error.message;
}

// Check local file system
const contentStructure = explorePath('src/content');
folderStatus.localStructure = contentStructure;

// Helper function remains the same...
function explorePath(basePath: string, maxDepth = 3, currentDepth = 0): any {
  if (currentDepth >= maxDepth || !fs.existsSync(basePath)) {
    return null;
  }
  
  try {
    const items = fs.readdirSync(basePath, { withFileTypes: true });
    const result: any = {};
    
    for (const item of items) {
      if (item.isDirectory()) {
        const subPath = path.join(basePath, item.name);
        result[item.name] = explorePath(subPath, maxDepth, currentDepth + 1);
      } else {
        if (!result._files) result._files = [];
        result._files.push(item.name);
      }
    }
    
    return result;
  } catch (error) {
    return { error: error.message };
  }
}

// Test collections
try {
  const abilities = await getCollection('abilities');
  collectionsStatus.abilities = `Found ${abilities.length} entries`;
} catch (error) {
  collectionsStatus.abilities = `Error: ${error.message}`;
}
---
<Layout title="Debug Collections" description='Debugging page for content collections'>
  <div class="container mx-auto p-8">
    <h1>Collection Debug Status</h1>
    
    <h2>Git Structure (what Vercel sees)</h2>
    <div class="mb-4 p-4 border rounded">
      <pre class="mt-2 bg-gray-100 p-2 rounded text-xs overflow-auto">{JSON.stringify(folderStatus.gitStructure || folderStatus.gitError, null, 2)}</pre>
    </div>
    
    <h2>Local File System Structure</h2>
    <div class="mb-4 p-4 border rounded">
      <pre class="mt-2 bg-gray-100 p-2 rounded text-xs overflow-auto">{JSON.stringify(folderStatus.localStructure, null, 2)}</pre>
    </div>
    
    <h2>Collection API Status</h2>
    {Object.entries(collectionsStatus).map(([name, status]) => (
      <p class="mb-2"><strong>{name}:</strong> {status}</p>
    ))}
  </div>
</Layout>