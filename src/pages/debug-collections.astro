---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

export const prerender = true;

let collectionsStatus: Record<string, string> = {};
let folderStatus: Record<string, any> = {};

// Helper function to recursively check folders
function explorePath(basePath: string, maxDepth = 3, currentDepth = 0): any {
  if (currentDepth >= maxDepth || !fs.existsSync(basePath)) {
    return null;
  }
  
  try {
    const items = fs.readdirSync(basePath, { withFileTypes: true });
    const result: any = {};
    
    for (const item of items) {
      if (item.isDirectory()) {
        const subPath = path.join(basePath, item.name);
        result[item.name] = explorePath(subPath, maxDepth, currentDepth + 1);
      } else {
        if (!result._files) result._files = [];
        result._files.push(item.name);
      }
    }
    
    return result;
  } catch (error) {
    return { error: error.message };
  }
}

// Check what actually exists starting from src/content
const contentStructure = explorePath('src/content');
folderStatus.completeStructure = contentStructure;

// Also check common variations
const possiblePaths = [
  'src/content/compendiums',
  'src/content/Compendiums', 
  'src/content/compendiums/csrd',
  'src/content/compendiums/CSRD',
  'src/content/Compendiums/CSRD',
  'src/content/compendiums/csrd/en',
  'src/content/compendiums/CSRD/en',
  'src/content/Compendiums/CSRD/en',
];

for (const checkPath of possiblePaths) {
  folderStatus[`exists_${checkPath}`] = fs.existsSync(checkPath);
}

// Test collections
try {
  const abilities = await getCollection('abilities');
  collectionsStatus.abilities = `Found ${abilities.length} entries`;
} catch (error) {
  collectionsStatus.abilities = `Error: ${error.message}`;
}
---
<Layout title="Debug Collections" description='Debugging page for content collections'>
  <div class="container mx-auto p-8">
    <h1>Collection Debug Status</h1>
    
    <h2>Complete Content Structure</h2>
    <div class="mb-4 p-4 border rounded">
      <pre class="mt-2 bg-gray-100 p-2 rounded text-xs overflow-auto">{JSON.stringify(folderStatus.completeStructure, null, 2)}</pre>
    </div>
    
    <h2>Path Existence Checks</h2>
    {Object.entries(folderStatus).filter(([key]) => key.startsWith('exists_')).map(([name, exists]) => (
      <p class="mb-1"><strong>{name.replace('exists_', '')}:</strong> {exists ? '✅ EXISTS' : '❌ NOT FOUND'}</p>
    ))}
    
    <h2>Collection API Status</h2>
    {Object.entries(collectionsStatus).map(([name, status]) => (
      <p class="mb-2"><strong>{name}:</strong> {status}</p>
    ))}
  </div>
</Layout>