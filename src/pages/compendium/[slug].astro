type Props = {
  entry: CollectionEntry<any>;
  systemKey: string;
  systemData: any;
  collectionKey: string;
  collectionData: any;
};

const { entry, systemKey, systemData, collectionKey, collectionData } =
  Astro.props;

// Get the current requested path
const requestedPath = Astro.url.pathname;
---

<Layout
  title="{entry.data.title}"
  description="{entry.data.description || 'Compendium entry'}"
>
  <article class="w-full flex flex-col items-center font-outfit">
    <header class="max-w-2xl mt-5">
      <div class="badge badge-outline italic">
        {systemData.name} - {collectionData.name}
      </div>
      <h1 class="md:text-4xl text-2xl font-extrabold mb-4">
        
      </h1>

      
    </header>

    <section class="prose md:prose-md mb-20 max-w-2xl">
      <code class="bg-gray-100 px-4 py-2 rounded block">
        {requestedPath}
      </code>
    </section>
  </article>
</Layout>
