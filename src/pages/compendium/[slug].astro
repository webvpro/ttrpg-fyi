import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import systems from "../../data/compendium-structure.json";

export const prerender = true;

export const getStaticPaths = async () => {
  const paths = [];
  const requestedPath = Astro.url.pathname;
  const systemKey = requestedPath.split('/')[2];
  const collectionKey = requestedPath.split('/')[3];
  
console.log('test', requestedPath)  // get a single system key from the URL
  

