---
// This file is auto-generated. Do not edit.
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import CollectionList from '../../../../components/ttrpg/vue/CollectionList.vue';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { page: undefined } },
  ];
}

const entries = await getCollection('artifacts');

// Get all rules collections
const allRules = await getCollection('rules');

// Transform the entries to simple data objects
const entriesData = entries.map(entry => ({
  id: entry.id,
  title: entry.data.title,
  rendered: entry.rendered, // IMPORTANT: Include rendered content
  ...entry.data // spread any other data properties
}));

// Find the "artifacts" rule and collect all referenced rules
const artifactsRule = allRules.find(rule => rule.id === 'artifacts');
let relevantRules = [];

if (artifactsRule) {
  // Add the artifacts rule itself
  relevantRules.push({
    id: artifactsRule.id,
    title: artifactsRule.data.title,
    rendered: artifactsRule.rendered,
    ...artifactsRule.data
  });

  // Add all rules referenced in rulesRef
  if (artifactsRule.data.rulesRef && Array.isArray(artifactsRule.data.rulesRef)) {
    const referencedRules = allRules.filter(rule => 
      artifactsRule.data.rulesRef.includes(rule.id)
    );

    relevantRules.push(...referencedRules.map(rule => ({
      id: rule.id,
      title: rule.data.title,
      rendered: rule.rendered,
      ...rule.data
    })));
  }
}

// Convert to object format expected by CollectionList
const rulesData = relevantRules.reduce((acc, rule) => {
  acc[rule.id] = rule;
  return acc;
}, {});

const pageTitle = "Artifacts";
const pageDescription = "A complete list of all artifacts";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="container mx-auto p-4">
    <CollectionList 
      entries={entriesData}
      rules={rulesData}
      collectionName="artifacts"
      folderName="artifacts"
      pageTitle={pageTitle}
      pageDescription={pageDescription}
      showDebug={import.meta.env.DEV}
      tabKey="artifacts"
      entriesFilters={['categories']}
      client:load
    />
  </div>
</Layout>
