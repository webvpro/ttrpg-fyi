---
// This file is auto-generated. Do not edit.
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import CollectionList from '../../../../components/ttrpg/vue/CollectionList.vue';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { page: undefined } },
  ];
}

const entries = await getCollection('characterarcs');

// Get all rules collections
const allRules = await getCollection('rules');

// Transform the entries to simple data objects
const entriesData = entries.map(entry => ({
  id: entry.id,
  title: entry.data.title,
  rendered: entry.rendered, // IMPORTANT: Include rendered content
  ...entry.data // spread any other data properties
}));

// Find the "character-arcs" rule and collect all referenced rules
const characterArcsRule = allRules.find(rule => rule.id === 'character-arcs');
let relevantRules = [];

if (characterArcsRule) {
  // Add the character arcs rule itself
  relevantRules.push({
    id: characterArcsRule.id,
    title: characterArcsRule.data.title,
    rendered: characterArcsRule.rendered,
    ...characterArcsRule.data
  });

  // Add all rules referenced in rulesRef
  if (characterArcsRule.data.rulesRef && Array.isArray(characterArcsRule.data.rulesRef)) {
    const referencedRules = allRules.filter(rule => 
      characterArcsRule.data.rulesRef.includes(rule.id)
    );

    relevantRules.push(...referencedRules.map(rule => ({
      id: rule.id,
      title: rule.data.title,
      rendered: rule.rendered,
      ...rule.data
    })));
  }
}

// Convert to object format expected by CollectionList
const rulesData = relevantRules.reduce((acc, rule) => {
  acc[rule.id] = rule;
  return acc;
}, {});

const pageTitle = "Character Arcs";
const pageDescription = "A complete list of all character arcs";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="container mx-auto p-4">
    <CollectionList 
      entries={entriesData}
      rules={rulesData}
      collectionName="characterarcs"
      folderName="character-arcs"
      pageTitle={pageTitle}
      pageDescription={pageDescription}
      showDebug={import.meta.env.DEV}
      tabKey="character-arcs"
      entriesFilters={['categories']}
      client:load
    />
  </div>
</Layout>
