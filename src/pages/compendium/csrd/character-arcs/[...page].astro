---
// This file is auto-generated. Do not edit.
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import CollectionList from '../../../../components/ttrpg/CollectionList.vue';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { page: undefined } },
  ];
}

const entries = await getCollection('characterarcs');

// Define which rule IDs you want to include for character arcs
const characterArcRuleIds = [
  'character-arcs',
  'character-arc-advancement',
  'arc-completion',
  'narrative-progression',
  // Add more rule IDs as needed
];

// Get rules collection filtered by the array of IDs
const filteredRules = await getCollection('rules', ({ id }) => 
  characterArcRuleIds.includes(id)
);

// Transform the entries to simple data objects
const entriesData = entries.map(entry => ({
  id: entry.id,
  title: entry.data.title,
  rendered: entry.rendered, // IMPORTANT: Include rendered content
  ...entry.data // spread any other data properties
}));

// Transform rules data
const rulesData = filteredRules.map(rule => ({
  id: rule.id,
  title: rule.data.title,
  rendered: rule.rendered, // Already rendered by getCollection
  ...rule.data
}));

const pageTitle = "Character Arcs";
const pageDescription = "A complete list of all character arcs";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="container mx-auto p-4">
    <h1 class="text-4xl font-bold mb-6">{pageTitle}</h1>
    
    <CollectionList 
      entries={entriesData}
      rules={rulesData}
      collectionName="characterarcs"
      folderName="character-arcs"
      pageTitle={pageTitle}
      pageDescription={pageDescription}
      showDebug={import.meta.env.DEV}
      client:load
    />
  </div>
</Layout>
