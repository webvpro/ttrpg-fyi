---
// This file is auto-generated. Do not edit.
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import CollectionList from '../../../../components/ttrpg/CollectionList.vue';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { page: undefined } },
  ];
}

const entries = await getCollection('abilities');
const rules = await getCollection('rules').then((rules: any[]) => {
  return rules.find((r: { id: string; }) => r.id.toLowerCase() === 'abilities');
})  || { data: {}, rendered: '' };

// Transform the entries to simple data objects
const entriesData = entries.map((entry: { id: any; data: { title: any; }; rendered: any; }) => ({
  id: entry.id,
  rendered: entry.rendered, // IMPORTANT: Include rendered content
  ...entry.data // spread any other data properties (including title)
}));

const pageTitle = "Abilities";
const pageDescription = "A complete list of all abilities";
---

<Layout title={pageTitle} description={pageDescription}>
       
    <h1 class="text-4xl font-bold mb-6">{pageTitle}</h1>
    

  <CollectionList 
    entries={entriesData}
    rules={rules}
    collectionName="abilities"
    folderName="abilities"
    pageTitle={pageTitle}
    pageDescription={pageDescription}
    showDebug={import.meta.env.DEV}
    client:load
  />
</Layout>
