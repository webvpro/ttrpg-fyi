---
// This file is auto-generated. Do not edit.
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import CollectionList from '../../../../components/ttrpg/CollectionList.vue';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { page: undefined } },
  ];
}

// Define which rule IDs you want to include for abilities
const abilityRuleIds = [
  'abilities',
  'ability-categories-and-relative-power',
];

// Single call to get entries with rendering
const entries = await getCollection('abilities');

// Single call to get filtered rules with rendering
const filteredRules = await getCollection('rules', ({ id }) => 
  abilityRuleIds.includes(id)
);

// Transform the entries to simple data objects
const entriesData = entries.map(entry => ({
  id: entry.id,
  title: entry.data.title,
  rendered: entry.rendered, // Already rendered by getCollection
  ...entry.data
}));

// Transform rules data
const rulesData = filteredRules.map(rule => ({
  id: rule.id,
  title: rule.data.title,
  rendered: rule.rendered, // Already rendered by getCollection
  ...rule.data
}));

const pageTitle = "Abilities";
const pageDescription = "A complete list of all abilities";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="container mx-auto p-4">
    <h1 class="text-4xl font-bold mb-6">{pageTitle}</h1>
    
    <CollectionList 
      entries={entriesData}
      rules={rulesData}
      collectionName="abilities"
      folderName="abilities"
      pageTitle={pageTitle}
      pageDescription={pageDescription}
      showDebug={import.meta.env.DEV}
      client:load
    />
  </div>
</Layout>
