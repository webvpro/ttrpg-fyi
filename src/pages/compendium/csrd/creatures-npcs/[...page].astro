---
// This file is auto-generated. Do not edit.
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import CollectionList from '../../../../components/ttrpg/vue/CollectionList.vue';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { page: undefined } },
  ];
}

const entries = await getCollection('creaturesnpcs');

// Get all rules collections
const allRules = await getCollection('rules');

// Transform the entries to simple data objects
const entriesData = entries.map(entry => ({
  id: entry.id,
  title: entry.data.title,
  rendered: entry.rendered, // IMPORTANT: Include rendered content
  ...entry.data // spread any other data properties
}));

// Find the "creatures-and-npcs" rule and collect all referenced rules
const creaturesRule = allRules.find(rule => rule.id === 'creatures-and-npcs');
let relevantRules = [];

if (creaturesRule) {
  // Add the creatures rule itself
  relevantRules.push({
    id: creaturesRule.id,
    title: creaturesRule.data.title,
    rendered: creaturesRule.rendered,
    ...creaturesRule.data
  });

  // Add all rules referenced in rulesRef
  if (creaturesRule.data.rulesRef && Array.isArray(creaturesRule.data.rulesRef)) {
    const referencedRules = allRules.filter(rule => 
      creaturesRule.data.rulesRef.includes(rule.id)
    );

    relevantRules.push(...referencedRules.map(rule => ({
      id: rule.id,
      title: rule.data.title,
      rendered: rule.rendered,
      ...rule.data
    })));
  }
}

// Convert to object format expected by CollectionList
const rulesData = relevantRules.reduce((acc, rule) => {
  acc[rule.id] = rule;
  return acc;
}, {});

const pageTitle = "Creatures & NPCs";
const pageDescription = "A complete list of all creatures and NPCs";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="container mx-auto p-4">
    <CollectionList 
      entries={entriesData}
      rules={rulesData}
      collectionName="creaturesnpcs"
      folderName="creatures-npcs"
      pageTitle={pageTitle}
      pageDescription={pageDescription}
      showDebug={import.meta.env.DEV}
      tabKey="creatures-npcs"
      entriesFilters={['categories']}
      client:load
    />
  </div>
</Layout>
