---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('skilllists');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'skilllists'>;
};

const { entry } = Astro.props;

// Handle content rendering safely
let Content: any = null;
let renderError: string | null = null;

try {
  if (entry && typeof entry.render === 'function') {
    const rendered = await entry.render();
    Content = rendered.Content;
  } else {
    renderError = 'Entry does not have a render method';
  }
} catch (error) {
  console.error('Error rendering entry:', error);
  renderError = error instanceof Error ? error.message : 'Unknown render error';
}
---
<Layout title={entry.data.title || entry.id} description={entry.data.description || `Details about ${entry.data.title || entry.id}`}>
  <div class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <a href="/compendium/csrd/skill-lists" class="text-blue-600 hover:underline">
        ← Back to Skill Lists
      </a>
    </div>
    
    <article class="prose lg:prose-xl max-w-none">
      <h1>{entry.data.title || entry.id}</h1>
      
      {renderError && (
        <div class="not-prose mb-4 p-4 bg-red-100 border border-red-400 rounded">
          <p class="text-red-800"><strong>Render Error:</strong> {renderError}</p>
          <details class="mt-2">
            <summary class="cursor-pointer text-sm">Debug Info</summary>
            <pre class="mt-2 text-xs bg-gray-100 p-2 rounded overflow-auto">{JSON.stringify({
              id: entry.id,
              hasData: !!entry.data,
              hasRender: typeof entry.render === 'function',
              dataKeys: entry.data ? Object.keys(entry.data) : []
            }, null, 2)}</pre>
          </details>
        </div>
      )}
      
      {Content && <Content />}
      
      {!Content && !renderError && (
        <div class="bg-yellow-100 border border-yellow-400 p-4 rounded">
          <p class="text-yellow-800">No content available for this entry.</p>
        </div>
      )}
    </article>
  </div>
</Layout>
