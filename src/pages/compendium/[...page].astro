---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import type { GetStaticPathsOptions } from "astro";
import compendiumStructure from "../../data/compendium-structure.json";
import CollectionCard from "../../components/CollectionCard.astro";
export const prerender = true;
export async function getStaticPaths() {
  const systems = Object.keys(compendiumStructure.systems);

  return systems.map((systemKey) => ({
    params: { page: systemKey },
    props: {
      systemKey,
      systemData: compendiumStructure.systems[systemKey],
    },
  }));
}

const { systemKey, systemData } = Astro.props;
const collections = Object.entries(systemData.collections);
---

<Layout title="Compendium" description="All articles">
  <div class="mt-16 flex justify-center items-center">
    <h1 class="text-3xl md:text-5xl font-outfit font-semibold text-center max-w-2xl">
      {systemData.name}
    </h1>
  </div>
  <p>
      {systemData.description}
    </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-20 mt-16">
    <CollectionCard collections={collections} system={systemKey} />
  </div>
</Layout>


