---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { createSessionClient, SESSION_COOKIE } from "../server/appwrite";
import { Icon } from "astro-icon/components";

const { user } = Astro.locals;

if (Astro.request.method === "POST") {
  const { account } = createSessionClient(Astro.request);

  await account.deleteSession("current");
  Astro.cookies.delete(SESSION_COOKIE);

  return Astro.redirect("/login");
}

if (!user) {
  return Astro.redirect("/login");
} 

function getInitials(name: string) {
  const [first, last] = name.split(" ");
  if (last) return `${first[0]}${last[0]}`;
  return `${first[0]}`;
}

const userInitials = getInitials(user.name);
---

<Layout title="Profile" description="Manage your TTRPG.fyi profile">
  <!-- Full-screen hero with background image -->
  <div class="hero min-h-screen profile-hero">
    <div class="hero-overlay bg-opacity-60"></div>
    <div class="hero-content text-center w-full max-w-6xl px-4">
      
      <!-- Profile Header -->
      <div class="card bg-base-100/90 backdrop-blur-sm shadow-2xl w-full max-w-4xl">
        <div class="card-body p-8">
          
          <!-- User Avatar and Info -->
          <div class="flex flex-col lg:flex-row items-center gap-8 mb-8">
            <!-- Avatar -->
            <div class="avatar placeholder">
              <div class="bg-primary text-primary-content rounded-full w-24 h-24">
                <span class="text-3xl font-bold">{userInitials}</span>
              </div>
            </div>
            
            <!-- User Info -->
            <div class="flex-1 text-center lg:text-left">
              <h1 class="text-4xl font-bold mb-2">{user.name}</h1>
              <p class="text-lg opacity-70 mb-2">{user.email}</p>
              <div class="badge badge-primary badge-lg">TTRPG Enthusiast</div>
            </div>
            
            <!-- Quick Actions -->
            <div class="flex gap-2">
              <button class="btn btn-circle btn-outline">
                <Icon name="mdi:pencil" class="w-6 h-6" />
              </button>
              <button class="btn btn-circle btn-outline">
                <Icon name="mdi:cog" class="w-6 h-6" />
              </button>
            </div>
          </div>

          <!-- Tabs for different sections -->
          <div class="tabs tabs-boxed mb-6">
            <a class="tab tab-active">Profile</a>
            <a class="tab">Preferences</a>
            <a class="tab">Security</a>
            <a class="tab">Collections</a>
          </div>

          <!-- Profile Content Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Profile Information Card -->
            <div class="card bg-base-200 shadow-lg">
              <div class="card-body">
                <h3 class="card-title flex items-center gap-2">
                  <Icon name="mdi:account" class="w-5 h-5" />
                  Profile Information
                </h3>
                
                <form class="space-y-4">
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text">Display Name</span>
                    </label>
                    <input type="text" class="input input-bordered" value={user.name} />
                  </div>
                  
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text">Email</span>
                    </label>
                    <input type="email" class="input input-bordered" value={user.email} />
                  </div>
                  
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text">Bio</span>
                    </label>
                    <textarea class="textarea textarea-bordered" placeholder="Tell us about your TTRPG adventures..."></textarea>
                  </div>
                  
                  <button class="btn btn-primary w-full">Update Profile</button>
                </form>
              </div>
            </div>

            <!-- Account Settings Card -->
            <div class="card bg-base-200 shadow-lg">
              <div class="card-body">
                <h3 class="card-title flex items-center gap-2">
                  <Icon name="mdi:lock" class="w-5 h-5" />
                  Account Settings
                </h3>
                
                <div class="space-y-4">
                  <div class="form-control">
                    <label class="label cursor-pointer">
                      <span class="label-text">Email notifications</span>
                      <input type="checkbox" class="toggle toggle-primary" checked />
                    </label>
                  </div>
                  
                  <div class="form-control">
                    <label class="label cursor-pointer">
                      <span class="label-text">Newsletter updates</span>
                      <input type="checkbox" class="toggle toggle-primary" />
                    </label>
                  </div>
                  
                  <div class="form-control">
                    <label class="label cursor-pointer">
                      <span class="label-text">Public profile</span>
                      <input type="checkbox" class="toggle toggle-primary" checked />
                    </label>
                  </div>
                  
                  <div class="divider"></div>
                  
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text">New Password</span>
                    </label>
                    <input type="password" class="input input-bordered" placeholder="Enter new password" />
                  </div>
                  
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text">Confirm Password</span>
                    </label>
                    <input type="password" class="input input-bordered" placeholder="Confirm new password" />
                  </div>
                  
                  <button class="btn btn-secondary w-full">Update Password</button>
                </div>
              </div>
            </div>

            <!-- Stats Card -->
            <div class="card bg-base-200 shadow-lg">
              <div class="card-body">
                <h3 class="card-title flex items-center gap-2">
                  <Icon name="mdi:chart-bar" class="w-5 h-5" />
                  Your TTRPG Stats
                </h3>
                
                <div class="stats stats-vertical shadow">
                  <div class="stat">
                    <div class="stat-title">Collections Viewed</div>
                    <div class="stat-value text-primary">15</div>
                    <div class="stat-desc">This month</div>
                  </div>
                  
                  <div class="stat">
                    <div class="stat-title">Favorite Systems</div>
                    <div class="stat-value text-secondary">3</div>
                    <div class="stat-desc">Bookmarked</div>
                  </div>
                  
                  <div class="stat">
                    <div class="stat-title">Member Since</div>
                    <div class="stat-value text-accent">2024</div>
                    <div class="stat-desc">Active user</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="card bg-base-200 shadow-lg">
              <div class="card-body">
                <h3 class="card-title flex items-center gap-2">
                  <Icon name="mdi:lightning-bolt" class="w-5 h-5" />
                  Quick Actions
                </h3>
                
                <div class="space-y-3">
                  <button class="btn btn-outline w-full justify-start">
                    <Icon name="mdi:heart" class="w-4 h-4 mr-2" />
                    View Bookmarks
                  </button>
                  
                  <button class="btn btn-outline w-full justify-start">
                    <Icon name="mdi:book-multiple" class="w-4 h-4 mr-2" />
                    Browse Compendium
                  </button>
                  
                  <button class="btn btn-outline w-full justify-start">
                    <Icon name="mdi:help-circle" class="w-4 h-4 mr-2" />
                    Help & Support
                  </button>
                  
                  <div class="divider"></div>
                  
                  <form method="POST" class="w-full">
                    <button type="submit" class="btn btn-error w-full justify-start">
                      <Icon name="mdi:logout" class="w-4 h-4 mr-2" />
                      Logout
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
.profile-hero {
  background-image: url('/images/ttrp_banner_2.png');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
}

/* Responsive background adjustments */
@media (max-width: 768px) {
  .profile-hero {
    background-attachment: scroll;
    background-position: center top;
  }
}

/* Ensure content is readable on all themes */
.hero-overlay {
  backdrop-filter: blur(2px);
}

/* Smooth transitions */
.card {
  transition: transform 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
}
</style>