---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets"; // ✅ Import Image component
import Layout from "../../layouts/Layout.astro";

export const prerender = true;
export const getStaticPaths = async () => {
  const posts = await getCollection("posts");
  const path = posts.map((post: CollectionEntry<"posts">) => {
    return {
      params: {
        slug: post.slug,
      },
      props: {
        post,
      },
    };
  });
  return path;
};

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="w-full flex flex-col items-center font-outfit">
    <header class="max-w-2xl mt-5">
      <!-- Category and Difficulty Badges -->
      <div class="flex gap-2 mb-4">
        <div class="badge badge-primary">
          {post.data.category}
        </div>
        <div class="badge badge-outline">
          {post.data.difficulty}
        </div>
        {post.data.featured && (
          <div class="badge badge-secondary">Featured</div>
        )}
      </div>

      <!-- Title -->
      <h1 class="md:text-4xl text-2xl font-extrabold mb-4">
        {post.data.title}
      </h1>

      <!-- Series Info -->
      {post.data.series && (
        <div class="alert alert-info mb-4">
          <span class="text-sm">Part of series: <strong>{post.data.series}</strong></span>
        </div>
      )}

      <!-- Author and Meta Info -->
      <section class="flex items-center justify-between mb-6">
        <div class="flex items-center">
          <div class="avatar placeholder">
            <div class="bg-neutral text-neutral-content rounded-full w-10">
              <span class="text-xs">{post.data.author.charAt(0)}</span>
            </div>
          </div>
          <div class="flex flex-col ml-3">
            <h2 class="text-md font-semibold">{post.data.author}</h2>
            <time class="text-xs opacity-70">{post.data.publishDate}</time>
          </div>
        </div>
        <div class="text-right">
          <div class="text-sm opacity-70">{post.data.readTime}</div>
        </div>
      </section>
    </header>

    <!-- Featured Image - Using Astro Image Component -->
    {post.data.image && (
      <figure class="max-w-2xl mb-6 w-full">
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          format="webp"
          class="rounded-xl w-full h-96 object-cover"
          loading="lazy"
        />
      </figure>
    )}

    <!-- Table of Contents -->
    {post.data.tableOfContents && (
      <nav class="toc max-w-2xl w-full mb-8 p-4 bg-base-200 rounded-lg">
        <h3 class="font-semibold mb-2">Table of Contents</h3>
        <!-- TOC will be auto-generated by your content or you can manually add it -->
      </nav>
    )}

    <!-- Article Content -->
    <section class="prose md:prose-lg prose-headings:font-outfit max-w-2xl mb-20">
      <Content />
    </section>

    <!-- Tags -->
    {post.data.tags && post.data.tags.length > 0 && (
      <footer class="max-w-2xl w-full">
        <h3 class="font-semibold mb-3">Tags</h3>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <div class="badge badge-outline">{tag}</div>
          ))}
        </div>
      </footer>
    )}

    <!-- Related Articles -->
    {post.data.relatedArticles && post.data.relatedArticles.length > 0 && (
      <section class="max-w-2xl w-full mt-12">
        <h3 class="font-semibold mb-4">Related Articles</h3>
        <div class="grid gap-4">
          {post.data.relatedArticles.map((slug: string) => (
            <a href={`/posts/${slug}`} class="card card-compact bg-base-200 hover:bg-base-300 transition-colors">
              <div class="card-body">
                <p class="text-sm opacity-70">→ {slug.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
