---
import { Image } from "astro:assets";
---

<section class="newsletter-section py-16">
  <div class="container mx-auto px-4">
    <div class="card image-full bg-base-300 shadow-2xl overflow-hidden">
      <!-- Background Image -->
      <figure class="relative">
        <Image
          src="https://images.unsplash.com/photo-1637825891028-564f672aa42c?q=80&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
          height={500}
          width={1900}
          alt="TTRPG dice and gaming setup on wooden table"
          format="webp"
          class="object-cover h-64 md:h-80 lg:h-96 w-full"
        />
        <!-- Overlay for better text readability -->
        <div class="absolute inset-0 bg-gradient-to-r from-primary/80 to-secondary/60"></div>
      </figure>

      <!-- Content Overlay -->
      <div class="card-body relative z-10 flex justify-center items-center text-center text-primary-content">
        <div class="max-w-2xl">
          <!-- Header Section -->
          <div class="mb-6">
            <div class="badge badge-accent badge-lg font-semibold mb-4">
              📬 Newsletter
            </div>
            <h2 class="card-title font-bold text-3xl md:text-4xl lg:text-5xl mb-4 font-outfit">
              Stay in the Loop
            </h2>
            <p class="text-lg md:text-xl opacity-90 leading-relaxed">
              Get the latest TTRPG insights, methodology articles, and gaming tips
              delivered straight to your inbox. Join our community of passionate gamers!
            </p>
          </div>

          <!-- Newsletter Form -->
          <div class="card bg-base-100/95 backdrop-blur-sm shadow-xl p-6 rounded-2xl">
            <form class="space-y-4" action="#" method="POST">
              <div class="form-control">
                <div class="flex flex-col md:flex-row gap-3">
                  <input
                    type="email"
                    name="email"
                    placeholder="Enter your email address"
                    class="input input-bordered input-lg flex-1 text-base-content bg-base-100 focus:input-primary"
                    required
                  />
                  <button
                    type="submit"
                    class="btn btn-primary btn-lg px-8 gap-2 group"
                  >
                    <span>Subscribe</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Privacy Notice -->
              <p class="text-xs text-base-content/60 leading-relaxed">
                By subscribing, you agree to receive our newsletter.
                <a href="/privacy" class="link link-primary">Privacy Policy</a> •
                Unsubscribe anytime
              </p>
            </form>
          </div>

          <!-- Features List -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8 text-primary-content/90">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-sm font-medium">Weekly TTRPG Tips</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-sm font-medium">Exclusive Content</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-sm font-medium">No Spam Ever</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Social Proof Section -->
    <div class="text-center mt-12">
      <div class="stats stats-horizontal shadow bg-base-100">
        <div class="stat">
          <div class="stat-figure text-primary">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
              <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"></path>
            </svg>
          </div>
          <div class="stat-title">Subscribers</div>
          <div class="stat-value text-primary">1,200+</div>
          <div class="stat-desc">Active readers</div>
        </div>

        <div class="stat">
          <div class="stat-figure text-secondary">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
            </svg>
          </div>
          <div class="stat-title">Articles Sent</div>
          <div class="stat-value text-secondary">50+</div>
          <div class="stat-desc">Quality content</div>
        </div>

        <div class="stat">
          <div class="stat-figure text-accent">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <div class="stat-title">Satisfaction</div>
          <div class="stat-value text-accent">98%</div>
          <div class="stat-desc">Reader rating</div>
        </div>
      </div>

      <!-- Testimonial -->
      <div class="card bg-base-200 shadow-lg mt-8 max-w-2xl mx-auto">
        <div class="card-body text-center">
          <div class="rating mb-4">
            <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" checked />
            <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" checked />
            <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" checked />
            <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" checked />
            <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400" checked />
          </div>
          <blockquote class="text-base-content/80 italic text-lg">
            "The TTRPG.fyi newsletter has completely transformed how I run my games.
            The insights are practical and immediately applicable!"
          </blockquote>
          <div class="flex items-center justify-center gap-3 mt-4">
            <div class="avatar placeholder">
              <div class="bg-neutral text-neutral-content rounded-full w-10">
                <span class="text-xs">GM</span>
              </div>
            </div>
            <div class="text-left">
              <div class="font-semibold text-base-content">Sarah M.</div>
              <div class="text-sm text-base-content/60">Veteran Game Master</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
