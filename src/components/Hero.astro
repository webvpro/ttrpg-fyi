---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<div class="hero min-h-screen relative overflow-hidden" style="background-image: url(./images/ttrpg-big-logo.png);">
  <!-- Hero Overlay for better text readability -->
  <div class="hero-overlay bg-opacity-40"></div>
  
  <!-- Hero Content -->
  <div class="hero-content text-center z-10 max-w-6xl px-4">
    <div class="max-w-4xl">
      
      <!-- Welcome Badge -->
      <div class="mb-6">
        <div class="badge badge-primary badge-lg font-outfit shadow-lg">
          🎲 Welcome to TTRPG Excellence
        </div>
      </div>
      
      <!-- Main Heading -->
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-outfit font-bold mb-8 text-base-content drop-shadow-lg">
        This is <span class="text-primary bg-primary/10 px-2 rounded-lg">TTRPG.fyi</span>
        <br />
        <span class="text-2xl md:text-4xl lg:text-5xl font-normal opacity-90">
          Your Comprehensive Resource for Tabletop RPG Excellence
        </span>
      </h1>
      
      <!-- Subtitle -->
      <p class="text-lg md:text-xl lg:text-2xl mb-12 opacity-80 max-w-3xl mx-auto">
        From players to publishers, discover resources, tools, and inspiration for better TTRPG experiences
      </p>
      
      <!-- Call to Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <a href="/compendium" class="btn btn-primary btn-lg shadow-xl">
          <Icon name="mdi:book-multiple" class="w-6 h-6 mr-2" />
          Explore Compendium
        </a>
        <a href="/about" class="btn btn-outline btn-lg shadow-xl">
          <Icon name="mdi:information" class="w-6 h-6 mr-2" />
          Learn More
        </a>
        <a href="/posts" class="btn btn-secondary btn-lg shadow-xl">
          <Icon name="mdi:newspaper" class="w-6 h-6 mr-2" />
          Read Articles
        </a>
      </div>
      
      <!-- Featured Stats -->
      <div class="stats stats-vertical lg:stats-horizontal shadow-2xl mb-16 bg-base-100/90 backdrop-blur-sm">
        <div class="stat">
          <div class="stat-figure text-primary">
            <Icon name="mdi:dice-6" class="w-8 h-8" />
          </div>
          <div class="stat-title">Game Systems</div>
          <div class="stat-value text-primary">50+</div>
          <div class="stat-desc">Comprehensive coverage</div>
        </div>
        
        <div class="stat">
          <div class="stat-figure text-secondary">
            <Icon name="mdi:account-group" class="w-8 h-8" />
          </div>
          <div class="stat-title">Community</div>
          <div class="stat-value text-secondary">10K+</div>
          <div class="stat-desc">Active users</div>
        </div>
        
        <div class="stat">
          <div class="stat-figure text-accent">
            <Icon name="mdi:star" class="w-8 h-8" />
          </div>
          <div class="stat-title">Resources</div>
          <div class="stat-value text-accent">1000+</div>
          <div class="stat-desc">Tips & guides</div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Floating elements for visual interest -->
  <div class="absolute top-20 left-10 opacity-20 animate-bounce">
    <Icon name="mdi:dice-6" class="w-16 h-16 text-primary" />
  </div>
  <div class="absolute top-40 right-20 opacity-20 animate-pulse">
    <Icon name="mdi:sword" class="w-12 h-12 text-secondary" />
  </div>
  <div class="absolute bottom-40 left-20 opacity-20 animate-bounce" style="animation-delay: 1s;">
    <Icon name="mdi:shield" class="w-14 h-14 text-accent" />
  </div>
</div>

<!-- Social Media Section -->
<section class="bg-base-200 py-16">
  <div class="container mx-auto px-4">
    <div class="text-center">
      <h2 class="text-2xl font-outfit font-semibold mb-8 flex items-center justify-center gap-2">
        <Icon name="mdi:heart" class="w-6 h-6 text-red-500" />
        Join Our Community
      </h2>
      
      <div class="flex justify-center space-x-4">
        <!-- X/Twitter -->
        <div class="tooltip" data-tip="Follow us on X">
          <a class="btn btn-circle btn-lg btn-outline hover:btn-primary transition-all duration-300" 
             href="https://www.x.com" aria-label="Follow on X/Twitter">
            <Icon name="mdi:twitter" class="w-6 h-6" />
          </a>
        </div>
        
        <!-- LinkedIn -->
        <div class="tooltip" data-tip="Connect on LinkedIn">
          <a class="btn btn-circle btn-lg btn-outline hover:btn-secondary transition-all duration-300" 
             href="https://www.linkedin.com" aria-label="Connect on LinkedIn">
            <Icon name="mdi:linkedin" class="w-6 h-6" />
          </a>
        </div>
        
        <!-- YouTube -->
        <div class="tooltip" data-tip="Subscribe on YouTube">
          <a class="btn btn-circle btn-lg btn-outline hover:btn-accent transition-all duration-300" 
             href="https://www.youtube.com" aria-label="Subscribe on YouTube">
            <Icon name="mdi:youtube" class="w-6 h-6" />
          </a>
        </div>
        
        <!-- Instagram -->
        <div class="tooltip" data-tip="Follow on Instagram">
          <a class="btn btn-circle btn-lg btn-outline hover:btn-info transition-all duration-300" 
             href="https://www.instagram.com" aria-label="Follow on Instagram">
            <Icon name="mdi:instagram" class="w-6 h-6" />
          </a>
        </div>
        
        <!-- Discord -->
        <div class="tooltip" data-tip="Join our Discord">
          <a class="btn btn-circle btn-lg btn-outline hover:btn-warning transition-all duration-300" 
             href="https://discord.gg/ttrpg" aria-label="Join Discord">
            <Icon name="mdi:discord" class="w-6 h-6" />
          </a>
        </div>
      </div>
      
      <!-- Newsletter Signup -->
      <div class="card bg-base-100 shadow-xl max-w-md mx-auto mt-12">
        <div class="card-body">
          <h3 class="card-title justify-center">
            <Icon name="mdi:email" class="w-5 h-5" />
            Stay Updated
          </h3>
          <p class="text-sm opacity-70 mb-4">Get the latest TTRPG resources and updates</p>
          <div class="form-control">
            <div class="input-group">
              <input type="email" placeholder="your@email.com" class="input input-bordered flex-1" />
              <button class="btn btn-primary">
                <Icon name="mdi:send" class="w-4 h-4" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* Custom animations and responsive adjustments */
@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
}

.animate-float {
  animation: float 6s ease-in-out infinite;
}

/* Ensure background covers properly */
.hero {
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
}

/* Mobile responsiveness */
@media (max-width: 768px) {
  .hero {
    background-attachment: scroll;
  }
  
  .stats {
    transform: scale(0.9);
  }
}

/* Enhanced text shadows for better readability */
.hero h1 {
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.hero p {
  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
}

/* Smooth transitions */
.btn {
  transition: all 0.3s ease;
}

.btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
}
</style>
