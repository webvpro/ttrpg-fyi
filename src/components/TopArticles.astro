---
import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";

// Get top articles - update to use 'featured' since 'topArticle' isn't in new schema
const allPosts = await getCollection("posts");
const topArticles = allPosts
  .filter((post) => post.data.featured === true || post.data.topArticle === true)
  .slice(0, 4); // Limit to 4 articles

const maxCardsToShow = 4;
---

<section class="top-articles-section">
  <!-- Header Section -->
  <div class="text-center mb-12">
    <div class="flex items-center justify-center gap-3 mb-4">
      <div class="badge badge-primary badge-lg font-semibold">
        ⭐ Top Picks
      </div>
    </div>
    
    <h1 class="text-4xl md:text-6xl font-outfit font-bold text-base-content mb-4">
      Top Articles
    </h1>
    
    <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
      Discover our most popular and impactful TTRPG methodology articles, 
      carefully curated to enhance your gaming experience.
    </p>
    
    <!-- Decorative divider -->
    <div class="divider divider-primary w-24 mx-auto mt-8">
      <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd"></path>
      </svg>
    </div>
  </div>

  <!-- Articles Grid -->
  {topArticles.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2 gap-8">
      {topArticles.map((post) => (
        <BlogCard posts={[post]} maxCardsToShow={1} />
      ))}
    </div>
  ) : (
    <!-- Empty State -->
    <div class="card bg-base-200 shadow-lg">
      <div class="card-body text-center py-16">
        <div class="text-6xl mb-6 opacity-40">📚</div>
        <h3 class="text-xl font-semibold text-base-content/70 mb-3">
          No Top Articles Yet
        </h3>
        <p class="text-base-content/50 mb-6 max-w-md mx-auto">
          Our featured articles will appear here once we've published 
          some amazing TTRPG content for you to explore.
        </p>
        <div class="card-actions justify-center">
          <a href="/posts" class="btn btn-primary gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0l-4-4m4 4l-4 4"></path>
            </svg>
            Browse All Articles
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- Call to Action Section -->
  {topArticles.length > 0 && (
    <div class="text-center mt-16">
      <div class="card bg-gradient-to-r from-primary/10 to-secondary/10 shadow-lg">
        <div class="card-body">
          <h3 class="text-2xl font-bold text-base-content mb-4">
            Want More TTRPG Insights?
          </h3>
          <p class="text-base-content/70 mb-6 max-w-lg mx-auto">
            Explore our full collection of articles covering storytelling, 
            player psychology, and advanced GM techniques.
          </p>
          <div class="card-actions justify-center gap-4">
            <a href="/posts" class="btn btn-primary btn-lg gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0l-4-4m4 4l-4 4"></path>
              </svg>
              View All Articles
            </a>
            <a href="/categories" class="btn btn-outline btn-lg gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
              </svg>
              Browse by Category
            </a>
          </div>
        </div>
      </div>
    </div>
  )}
</section>

<!-- Optional: Statistics Section -->
<div class="stats stats-vertical lg:stats-horizontal shadow mt-12 bg-base-100">
  <div class="stat">
    <div class="stat-figure text-primary">
      <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
      </svg>
    </div>
    <div class="stat-title">Total Articles</div>
    <div class="stat-value text-primary">{allPosts.length}</div>
    <div class="stat-desc">Growing library</div>
  </div>
  
  <div class="stat">
    <div class="stat-figure text-secondary">
      <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
      </svg>
    </div>
    <div class="stat-title">Featured</div>
    <div class="stat-value text-secondary">{topArticles.length}</div>
    <div class="stat-desc">Top quality content</div>
  </div>
  
  <div class="stat">
    <div class="stat-figure text-accent">
      <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
      </svg>
    </div>
    <div class="stat-title">Categories</div>
    <div class="stat-value text-accent">{new Set(allPosts.map(post => post.data.category)).size}</div>
    <div class="stat-desc">Diverse topics</div>
  </div>
</div>
