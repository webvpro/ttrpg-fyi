import ThemeToggle from "../components/ThemeToggle.astro";

const { user } = Astro.locals;

const navigation = [
  { name: "Home", href: "/" },
  { name: "CSRD", href: "/compendium/csrd" },
  { name: "About", href: "/about" },
];

if (user) {
  navigation.push({ name: "Dashboard", href: "/account" });
} else {
  navigation.push({ name: "Login", href: "/login" });
  navigation.push({ name: "Sign Up", href: "/signup" });
}

// Only access pathname if request exists (for prerendered pages)
const pathname = Astro.request ? new URL(Astro.request.url).pathname : '';

