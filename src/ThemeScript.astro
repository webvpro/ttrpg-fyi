<template>
  <header class="sticky top-0 z-50">
    <nav class="navbar bg-base-100/90 shadow-sm font-outfit backdrop-blur-lg justify-center items-center py-2 md:px-10 px-5">
      
      <!-- Mobile Menu Button & Brand -->
      <div class="navbar-start">
        <div class="dropdown">
          <button
            tabindex="0"
            role="button"
            class="btn btn-ghost lg:hidden"
            aria-label="Open menu"
          >
            <Icon icon="mdi:menu" class="w-5 h-5" />
          </button>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
            <li v-for="item in navigation" :key="item.href">
              <a 
                :href="item.href" 
                :class="[
                  'flex items-center gap-2',
                  { 'active': isCurrentPath(item.href) }
                ]"
              >
                <Icon :icon="item.icon" class="w-4 h-4" />
                {{ item.label }}
              </a>
            </li>
            
            <!-- Mobile auth options -->
            <li class="border-t border-base-300 mt-2 pt-2 lg:hidden">
              <!-- Show user info if logged in -->
              <div v-if="user" class="px-4 py-2">
                <div class="font-semibold">{{ user.name }}</div>
                <div class="text-sm opacity-70">{{ user.email }}</div>
              </div>
              
              <!-- Show login if not logged in -->
              <template v-else>
                <a href="/login" class="flex items-center gap-2">
                  <Icon icon="mdi:login" class="w-4 h-4" />
                  Login
                </a>
              </template>
            </li>
            
            <!-- Mobile user menu items (when logged in) -->
            <template v-if="user">
              <li class="lg:hidden">
                <a href="/dashboard" class="flex items-center gap-2">
                  <Icon icon="mdi:view-dashboard" class="w-4 h-4" />
                  Dashboard
                </a>
              </li>
              <li class="lg:hidden">
                <a href="/profile" class="flex items-center gap-2">
                  <Icon icon="mdi:account-edit" class="w-4 h-4" />
                  Settings
                </a>
              </li>
              <li class="lg:hidden">
                <button @click="logout" class="flex items-center gap-2 text-error w-full text-left">
                  <Icon icon="mdi:logout" class="w-4 h-4" />
                  Logout
                </button>
              </li>
            </template>
            
            <!-- Mobile signup (when not logged in) -->
            <li v-if="!user" class="lg:hidden">
              <a href="/signup" class="flex items-center gap-2">
                <Icon icon="mdi:account-plus" class="w-4 h-4" />
                Sign Up
              </a>
            </li>
            
            <!-- Mobile cookie settings -->
            <li class="border-t border-base-300 mt-2 pt-2 lg:hidden">
              <button @click="showCookieSettings" class="flex items-center gap-2 w-full text-left">
                <Icon icon="mdi:cookie" class="w-4 h-4" />
                Cookie Settings
              </button>
            </li>
          </ul>
        </div>
        <a class="btn btn-ghost text-xl flex items-center gap-2" href="/"> 
          <Icon icon="game-icons:d20" class="w-6 h-6" />
          <span class="font-bold">TTRPG.fyi</span>
        </a>
      </div>
      
      <!-- Desktop Navigation -->
      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1">
          <li v-for="item in navigation" :key="item.href">
            <a 
              :href="item.href" 
              :class="[
                'flex items-center gap-2',
                { 'active': isCurrentPath(item.href) }
              ]"
            >
              <Icon :icon="item.icon" class="w-4 h-4" />
              {{ item.label }}
            </a>
          </li>
        </ul>
      </div>
      
      <!-- Right Side Actions -->
      <div class="navbar-end flex items-center gap-2">
        <!-- Cookie Settings Button -->
        <button 
          @click="showCookieSettings"
          class="btn btn-ghost btn-sm flex items-center gap-1"
          title="Cookie Settings"
        >
          <Icon icon="mdi:cookie" class="w-4 h-4" />
          <span class="hidden sm:inline">Cookies</span>
        </button>
        
        <!-- Theme Toggle -->
        <ThemeToggle />
        
        <!-- User Profile Menu (when logged in) -->
        <div v-if="user" class="dropdown dropdown-end">
          <button 
            tabindex="0" 
            role="button" 
            class="btn btn-ghost btn-circle avatar"
            aria-label="User menu"
            :title="`Logged in as ${user.name}`"
          >
            <div class="w-10 rounded-full bg-primary bg-opacity-10 flex items-center justify-center">
              <img 
                v-if="user.avatar" 
                :src="user.avatar" 
                :alt="user.name"
                class="w-full h-full rounded-full object-cover"
              />
              <Icon v-else icon="mdi:account-circle" class="w-6 h-6 text-primary" />
            </div>
          </button>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
            <li class="menu-title">
              <span>{{ user.name }}</span>
              <span class="text-xs opacity-70">{{ user.email }}</span>
            </li>
            <li>
              <a href="/dashboard" class="flex items-center gap-2">
                <Icon icon="mdi:view-dashboard" class="w-4 h-4" />
                Dashboard
              </a>
            </li>
            <li>
              <a href="/profile" class="flex items-center gap-2">
                <Icon icon="mdi:account-edit" class="w-4 h-4" />
                Profile Settings
              </a>
            </li>
            <li>
              <a href="/campaigns" class="flex items-center gap-2">
                <Icon icon="game-icons:d20" class="w-4 h-4" />
                My Campaigns
              </a>
            </li>
            <li class="border-t border-base-300 mt-2 pt-2">
              <button @click="logout" class="flex items-center gap-2 text-error hover:bg-error hover:bg-opacity-10 w-full text-left">
                <Icon icon="mdi:logout" class="w-4 h-4" />
                Logout
              </button>
            </li>
          </ul>
        </div>
        
        <!-- Auth Buttons (when NOT logged in) -->
        <template v-else>
          <a href="/login" class="btn btn-ghost btn-sm flex items-center gap-1">
            <Icon icon="mdi:login" class="w-4 h-4" />
            <span class="hidden sm:inline">Login</span>
          </a>
          <a href="/signup" class="btn btn-primary btn-sm flex items-center gap-1">
            <Icon icon="mdi:account-plus" class="w-4 h-4" />
            <span class="hidden sm:inline">Sign Up</span>
          </a>
        </template>
      </div>
    </nav>
  </header>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted } from 'vue'
import { Icon } from '@iconify/vue'
import ThemeToggle from './ThemeToggle.vue'

// Types
interface User {
  id: string
  name: string
  email: string
  avatar?: string
}

interface NavigationItem {
  label: string
  href: string
  icon: string
}

// Extend Window interface
declare global {
  interface Window {
    showCookieSettings?: () => void;
    CookieConsent?: {
      showSettings: () => void;
    };
  }
}

// Props - accept user from Astro if passed
const props = defineProps<{
  user?: User | null
}>()

// State - initialize with prop or null
const user = ref<User | null>(props.user || null)
const currentPath = ref('')

// Navigation items with Iconify icons
const navigation = computed<NavigationItem[]>(() => [
  { label: 'Home', href: '/', icon: 'mdi:home' },
  { label: 'CSRD', href: '/compendium/csrd', icon: 'game-icons:d20' },
  { label: 'About', href: '/about', icon: 'mdi:information' },
])

// Methods
const isCurrentPath = (href: string): boolean => {
  if (href === '/') {
    return currentPath.value === '/'
  }
  return currentPath.value.startsWith(href)
}

const updateCurrentPath = () => {
  if (typeof window !== 'undefined') {
    currentPath.value = window.location.pathname
  }
}

const showCookieSettings = () => {
  console.log('Cookie settings button clicked')
  
  if (typeof window !== 'undefined') {
    // Try different cookie consent methods
    if (window.showCookieSettings) {
      console.log('Using window.showCookieSettings')
      window.showCookieSettings()
    } else if (window.CookieConsent?.showSettings) {
      console.log('Using CookieConsent.showSettings')
      window.CookieConsent.showSettings()
    } else {
      // Fallback - redirect to privacy policy or show an alert
      console.log('No cookie settings function found')
      alert('Cookie settings functionality is not yet implemented. Please visit our Privacy Policy page for more information.')
      // Alternative: window.location.href = '/privacy-policy'
    }
  }
}

const checkAuthStatus = async () => {
  // TEMPORARY: For testing, simulate a logged-in user
  // Comment this out when you have real auth working
  user.value = {
    id: '1',
    name: 'John Doe',
    email: 'john@example.com',
    avatar: ''
  }
  console.log('User set to:', user.value)
  return

  // Uncomment this when you have auth API working
  /*
  try {
    console.log('Checking auth status...')
    const response = await fetch('/api/auth/me', {
      credentials: 'include'
    })
    
    if (response.ok) {
      const userData = await response.json()
      user.value = userData
      console.log('User logged in:', userData)
    } else {
      user.value = null
      console.log('User not logged in')
    }
  } catch (error) {
    console.error('Error checking auth status:', error)
    user.value = null
  }
  */
}

const logout = async () => {
  try {
    console.log('Logging out...')
    
    // Clear user state immediately
    user.value = null
    
    // Uncomment this when you have auth API working
    /*
    await fetch('/api/auth/logout', {
      method: 'POST',
      credentials: 'include'
    })
    */
    
    console.log('User logged out')
    
    // Redirect to home
    if (typeof window !== 'undefined') {
      window.location.href = '/'
    }
  } catch (error) {
    console.error('Error logging out:', error)
    // Still clear user state even if API fails
    user.value = null
  }
}

// Event handlers
const handlePopState = () => {
  updateCurrentPath()
}

const handleAuthChange = () => {
  checkAuthStatus()
}

// Lifecycle
onMounted(() => {
  console.log('Navbar mounted with props:', props)
  updateCurrentPath()
  
  // Only check auth if no user was passed from props
  if (!props.user) {
    checkAuthStatus()
  } else {
    console.log('Using user from props:', props.user)
  }
  
  // Listen for navigation changes
  if (typeof window !== 'undefined') {
    window.addEventListener('popstate', handlePopState)
    window.addEventListener('auth-changed', handleAuthChange)
  }
})

onUnmounted(() => {
  if (typeof window !== 'undefined') {
    window.removeEventListener('popstate', handlePopState)
    window.removeEventListener('auth-changed', handleAuthChange)
  }
})

// Expose methods for parent components
defineExpose({
  refreshAuth: checkAuthStatus,
  user: computed(() => user.value),
  logout
})
</script>

<style scoped>
/* DaisyUI theme-aware styles - no @apply needed */

/* Ensure dropdown appears above other content */
.dropdown-content {
  z-index: 9999;
}

/* Smooth transitions */
.navbar a {
  transition: all 0.2s ease-in-out;
}

/* Mobile menu styling */
@media (max-width: 1023px) {
  .navbar-center {
    display: none;
  }
}

/* Custom hover effects */
.navbar a:hover {
  transform: translateY(-1px);
}
</style>